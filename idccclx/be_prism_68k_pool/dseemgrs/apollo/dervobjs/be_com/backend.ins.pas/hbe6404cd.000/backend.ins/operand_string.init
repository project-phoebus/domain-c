{ operand_string.init - a DSEE derived object of be_com/backend.ins.pas
  (cc.a88k only): the initializer of the section operand_string
  (0x2B6E0C: 32 entries of 25 characters, the names of the operand
  kinds, operand$t's elements without the prefix).  Included by asm.pas.

  No Apollo copy survives; reconstructed from the DOMAIN C 6.9 binary
  cc.a88k, the section's bytes.

  How the section is shared (docs/questions.md 161, settled by
  translator PB2): backend.ins.pas declares the section's variable for
  every unit (`var (operand_string) operand_string: ...'); this file, included by
  the one unit that holds the data, gives it its initial value with a
  `define' statement (the language reference's section 7.2.2, method 2:
  a define statement after the var declaration, "useful ... when you
  write an %include file").  dpc lays the defined variable out in the
  named section with its data.

  Not known from the original: the file's layout. }

define operand_string := [
    'none                     ',
    'ip_reg                   ',
    'fp_reg                   ',
    'fp_reg_pair              ',
    'ip_reg_physical          ',
    'fp_reg_physical          ',
    'fp_reg_pair_physical     ',
    'ip_condition_codes       ',
    'fp_condition_codes       ',
    'argument_block_memory    ',
    'inscrutable_memory       ',
    'well_behaved_memory      ',
    'ip_reg_like              ',
    'fp_reg_like              ',
    'fp_reg_pair_like         ',
    'forward_label_reference  ',
    'flow_graph_edge          ',
    'case_jump_base           ',
    'displacement_routine     ',
    'displacement_arg_block   ',
    'displacement_stack_frame ',
    'displacement_literal_pool',
    'displacement_XSB_base    ',
    'immediate                ',
    'bind_time_immediate      ',
    'symbol_definition        ',
    'label_reference          ',
    'join_birthpoint_inputs   ',
    'exception_information    ',
    'spare_3                  ',
    'spare_2                  ',
    'spare_1                  '];
