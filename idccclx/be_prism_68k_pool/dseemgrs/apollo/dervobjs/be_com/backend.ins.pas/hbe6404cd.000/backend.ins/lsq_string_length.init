{ lsq_string_length.init - a DSEE derived object of be_com/backend.ins.pas
  (cc.a88k only): lsq_string's lengths.
  Included by dmp.pas after its other inserts.

  No Apollo copy survives; reconstructed from the DOMAIN C 6.9 binary
  cc.a88k: dmp's data +0x240 (8 bytes, set by .rwdi).

  Not known from the original: the declaration's form (its name is the
  file's). }

var
  lsq_string_length: array [lsq$t] of integer := [
    6, 4, 6, 8];
