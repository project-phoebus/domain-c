        p1_already_ptr_t(solution)^.already_processor_reg := p1_already_ptr_t(addr(subject))^.already_processor_reg;
        p1_already_ptr_t(solution)^.already_ip_reg := true;
        work := solution;
        result := solution;
      end;
    end;
  end;
end;
