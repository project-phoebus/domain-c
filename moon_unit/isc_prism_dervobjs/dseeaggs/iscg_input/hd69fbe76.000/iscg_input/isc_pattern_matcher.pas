    solution$sc_reg, solution$sr_reg, solution$dummy, solution$any_solution,
    solution$irrelevant, solution$void:
      ;
    otherwise
      if isc_user_routines_356 or isc_user_routines_354 then begin
        write('ISC: source line ');
        write(inh^.pos.source_line_number:1);
        write(': pattern_matcher: Unrecognized solution^.kind.');
        writeln;
        end
      else
        bug_check('ISC: source line %wd: pattern_matcher: Unrecognized solution^.kind.%$',
                  inh^.pos.source_line_number);
    end;
  if isc_user_routines_354 then begin
    write('*************************');
    writeln;
    write('pattern_matcher: exiting.');
    writeln;
    write('*************************');
    writeln;
    writeln;
    write('work_list:');
    writeln;
    i := 0;
    p := work_list^.first;
    while p <> nil do begin
      i := i + 1;
      write('Work list[');
      write(i:1);
      write(']:');
      writeln;
      dump_solution(p^.sol, 0, false);
      writeln;
      p := p^.next;
    end;
    writeln;
    write('solutions_of_parent:');
    writeln;
    i := 0;
    p := solutions_of_parent^.first;
    while p <> nil do begin
      i := i + 1;
      write('Solutions of parent[');
      write(i:1);
      write(']:');
      writeln;
      dump_solution(p^.sol, 0, false);
      writeln;
      p := p^.next;
    end;
    writeln;
  end;
end;
