    end
    else if isc_user_routines_354 then begin
      write('The following solution was NOT added to the work list:');
      writeln;
      dump_solution(add_this_to_work_list, 0, false);
    end;
  end;
end;

{ pattern_matcher - every rule whose pattern solution matches tried
  (hard_work), with the traces of its arguments before and of the
  lists after: `case solution^.kind of' (a chain rule's subject kind,
  every kind 1..23 a label; any other kind an error, a message under
  the traces, else bug_check) and, for a proper_subtree, `case
  il$t(solution^.w98) of' (an operator no pattern names an error); in
  each arm the rules tried under it, in rule order, each when its
  pattern's tests hold (children's kinds, nested proper_subtrees'
  operators, in pattern order).  The case statements are the
  generator's (the rule file's patterns).

  0x200D6E, 0x7944 bytes: solution 8, work_list 12, solutions_of_parent
  16, il 20, inh 24, permissible 28; A3 solution, D5 work_list, D4
  solutions_of_parent, D3 inh.  Two word jump tables: by kind
  (0x201078, kinds 1..23; out of range 0x208434) and by il$t
  (0x201362, 1..177; out of range and unlabelled 0x2083C8).  The
  trace's lists: the cells of solution_list_t; `i' is -8.

  Not known from the original: the locals' names. }

procedure pattern_matcher(
    solution: isc_solution_ptr_t;
    work_list: solution_list_ptr_t;
    solutions_of_parent: solution_list_ptr_t;
    il: univ_ptr;
    inh: inherited_attributes_ptr_t;
    permissible: solution$set_t); options(val_param);
var
  i: integer32;
  p: solution_cell_ptr_t;
begin
  isc_user_routines_2f8 := isc_user_routines_2f8 + 1;
