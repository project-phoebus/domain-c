    write('**************************');
    writeln;
    write('pattern_matcher: entering.');
    writeln;
    write('**************************');
    writeln;
    writeln;
    write('arg 1 (solution):');
    writeln;
    dump_solution(solution, 0, false);
    writeln;
    write('work_list:');
    writeln;
    i := 0;
    p := work_list^.first;
    while p <> nil do begin
      i := i + 1;
      write('Work list[');
      write(i:1);
      write(']:');
      writeln;
      dump_solution(p^.sol, 0, false);
      writeln;
      p := p^.next;
    end;
    writeln;
    write('solutions_of_parent:');
    writeln;
    i := 0;
    p := solutions_of_parent^.first;
    while p <> nil do begin
      i := i + 1;
      write('solution of parent[');
      write(i:1);
      write(']:');
      writeln;
      dump_solution(p^.sol, 0, false);
      writeln;
      p := p^.next;
    end;
    writeln;
    if isc_user_routines_354 then begin
      write('***********************');
      writeln;
      write('Start pattern-matching:');
      writeln;
      write('***********************');
      writeln;
      writeln;
    end;
  end;
  pm_proper_subtree_seen := false;
  case solution$t(solution^.kind) of
    solution$address_mode: begin
      hard_work(solution, work_list, solutions_of_parent, il, inh, permissible, 378);
