{ transform_533_pass_1 - rule 533: ip_reg <- set_and_top ($1: ip_reg, $2:
  ip_reg).
  0x14FB70, 0x280 bytes. }
procedure transform_533_pass_1(var subject: isc_solution_t; il: univ_ptr;
    inh: inherited_attributes_ptr_t; var work, result: isc_solution_ptr_t);
    options(val_param);
var
  solution: isc_solution_ptr_t;     { the new solution (`result') }
  t2: 0..65535;
  t3: 0..65535;
begin
  result := nil;
  work := nil;
  if integer32(p2_node_ptr_t(subject.il)^.p[5]) <= 4 then begin
    if isc_user_routines_354 then begin
      write('Pattern 533 matched the semantics.');
      writeln;
    end;
    if subject.already_ip_reg then begin
      if isc_user_routines_354 then begin
        write('Infinite cycle prevented by NOT adding this to the work list.');
        writeln;
      end;
    end
    else begin
      solution := new_solution(isc_heap, solution$ip_reg, 0, inh, il, il_none);
      solution^.which_transform := 533;
      solution^.before_transform := addr(subject);
      solution^.code_bytes := subject.children[1]^.code_bytes + subject.children[2]^.code_bytes + 4;
      solution^.memory_references := subject.children[1]^.memory_references + subject.children[2]^.memory_references;
      solution^.delay := subject.children[1]^.delay + subject.children[2]^.delay;
      solution^.bits_known := bits_known_function(subject.il_kind,
          subject.children[1]^.bits_known, subject.children[2]^.bits_known);
      solution^.bits_trusted := bits_trusted_function(subject.il_kind,
          subject.children[1]^.bits_trusted,
          subject.children[2]^.bits_trusted);
      solution^.f76.embedded_strength_reduction_temporary := subject.children[1]^.f76.embedded_strength_reduction_temporary or subject.children[2]^.f76.embedded_strength_reduction_temporary;
      solution^.evaluation_order := evaluation_order_function(subject.il_kind,
          subject.children[1]^.ip_reg_max, subject.children[2]^.ip_reg_max,
          legal_evaluation_orders(subject.children[1], subject.children[2]));
      t2 := subject.children[1]^.ip_reg_max;
      if t2 = subject.children[2]^.ip_reg_max then begin
        solution^.ip_reg_max := t2 + 1;
      end else begin
        if t2 <= subject.children[2]^.ip_reg_max then begin
          t3 := subject.children[2]^.ip_reg_max;
        end else begin
          t3 := t2;
        end;
        solution^.ip_reg_max := t3;
      end;
      solution^.ip_reg_result := 1;
      solution^.already_address_mode := subject.already_address_mode;
      solution^.already_fp_reg := subject.already_fp_reg;
      solution^.already_fp_reg_pair := subject.already_fp_reg_pair;
      solution^.already_fp_reg_quad := subject.already_fp_reg_quad;
      solution^.already_ip_reg := subject.already_ip_reg;
      solution^.already_ip_reg_field := subject.already_ip_reg_field;
      solution^.already_processor_reg := subject.already_processor_reg;
      solution^.already_ip_reg := true;
      work := solution;
      result := solution;
    end;
  end;
end;

