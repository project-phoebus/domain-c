transform 12  address_mode <- set_con_ob
  pass_1 image 16#11E0C0 begin
    temp t2: pointer;
    temp t3: pointer;
    temp t4: solution;
    condition not (not subject.inherited_attributes.immediate_parent_wants_set_temporary or not is_all_zeroes(subject.il));
    cycle_guard already_address_mode;
    result.l360 <- rshft(subject.il.w16 + 3, 2) * 4;
    t2 <- make_expression_temporary(122, rshft(subject.il.w16 + 3, 2) * 4 * 8);
    side_effect_set_var_$address_exposed(t2);
    t3 <- t2;
    result.l356 <- t3;
    t4 <- address_mode_for_expression_temporary(t3, result.l360 * 8, 0, 3);
    result.l352 <- t4;
    if not lir_$can_encode_as_immediate_operand(t4.literal_32_bits_value + result.l360 - 1, opc$loadl, 1) and not result.l352.has_a_symbolic_displacement or result.l352.uses_the_index_register then
      result.c136 <- 2;
      if result.l352.uses_the_base_register then
        result.c137 <- 1;
        if result.l352.literal_32_bits_value <> 0 or result.l352.uses_the_index_register or result.l352.has_a_symbolic_displacement then
          result.c138 <- 2;
        else
          result.c138 <- 1;
        end;
      else
        result.c137 <- 2;
        if lir_$can_encode_as_immediate_operand(result.l352.literal_32_bits_value, opc$move, 1) then
          result.c139 <- 1;
        else
          result.c139 <- 2;
        end;
      end;
    else
      result.c136 <- 1;
    end;
    if not result.l352.uses_the_displacement then
      result.c140 <- 1;
    else
      result.c140 <- 2;
    end;
    result.code_bytes <- result.l360 div 4 * 4 + words(0, 4)[result.c138] + words(4, 4)[result.c139];
    result.memory_references <- result.l360 div 4 + bytes(0, 1)[result.c139];
    result.delay <- bytes(0, 1)[result.c139];
    result.bits_known <- 0;
    result.bits_trusted <- 3;
    result.has_a_symbolic_displacement <- true;
    result.literal_32_bits_value <- 0;
    result.il <- result.l356;
    result.ip_reg_max <- 0;
    result.ip_reg_result <- 0;
    result.is_set_temporary <- true;
    result.uses_the_base_register <- true;
    result.uses_the_displacement <- true;
    result.uses_the_index_register <- false;
  end;
  pass_2 image 16#1AA5E0 begin
    temp t1: solution;
    temp t2: solution;
    temp t3: solution;
    if result.c136 <> 1 then
      t1 <- create_solution_for_ip_reg();
      if result.c137 = 1 then
        if result.c138 = 1 then
          if t1.object_with_name <> nil then
            t1.object_with_name <- t1.object_with_name;
          else
            t1.object_with_name <- result.l352.base_register.object_with_name;
          end;
          emit simple(opc$move, 0, result.l352.base_register, t1, nil);
          emit simple(opc$adj_move, 0, nil, nil, nil);
