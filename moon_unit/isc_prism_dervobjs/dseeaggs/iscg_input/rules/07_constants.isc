transform 10  literal_32_bits <- real_ob
  pass_1 image 16#11DE24 hand begin
    { written by hand: the image converts the node's double to a single
      through the FPP emulation (the double copied to a local, `jsr
      fpp_$', 0x0074 0x00D4 0xFF3E: the single stored to a temporary,
      copied to a four-byte local and read as a longword), which the
      lifter does not follow; real := double is dpc gap 7 (the gate's
      rewrite drops the conversion) }
    temp f: single;
    f.value <- subject.il.real_value;
    result.code_bytes <- 0;
    result.memory_references <- 0;
    result.delay <- 0;
    result.bits_known <- f.bits;
    result.bits_trusted <- -1;
    result.literal_32_bits_value <- f.bits;
