{ declarations.isc - the ISC generator's input (docs/iscg-design.md), the declarations.
  Written by tools/iscg_extract.py from cc.a88k; tools/iscg_gen.py
  generates the ISC's Pascal from these files.  Not known from the
  original: the language's syntax (only "pattern", "transform" and
  `let result <- ...;' survive in the image), the files' names and
  layout. }


{ The solution kinds (solution$t: the SOLUTION$ identifiers). }
kinds none, case_jump_base, fp_reg_pair_high, fp_reg_pair_low, local_routine, address_mode, ctl_reg, flow, fp_reg, fp_reg_pair, fp_reg_quad, ip_reg, ip_reg_field, ip_reg_scaled, literal_32_bits, literal_64_bits, processor_reg, sc_reg, sr_reg, dummy, any_solution, irrelevant, proper_subtree, void, k_max;

{ The attributes, as dump_solution prints them: name, offset (and bit)
  in the solution, size class. }
attribute kind +108 integer;
attribute il_kind +98 integer;
attribute which_transform +112 integer;
attribute advancing_displacement +28 integer32;
attribute all_zeroes_or_all_ones +81.7 boolean;
attribute arg_block_location +81.6 boolean;
attribute bit_7_was_sign_extended +81.5 boolean;
attribute bit_15_was_sign_extended +81.4 boolean;
