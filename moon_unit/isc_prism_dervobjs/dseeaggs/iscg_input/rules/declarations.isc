operator isc_assign_node_agg_aop il agg_aop children 2 image 16#0DCD58;
  if (il.w52 = 9) and (il.w56 <> 0);
    trace rewrite;
    let n2 <- rewrite_$agg_aop(il);
    child solutions n2 copy_all
      il <- n2;
      original_il <- il;
      permissible inherited;
    solutions_made;
  else;
    child 1 il.p64
      immediate_parent_wants_lvalue <- true;
      exception_frame <- il.p12;
      fetch_precision <- isc_$precision_from_rlen_and_size(il.w52, il.l48);
      required_arithmetic <- rlen_arith(il.w52);
      required_precision <- isc_$precision_from_rlen_and_size(il.w52, il.l48);
      permissible [address_mode, fp_reg, fp_reg_pair, fp_reg_quad, ip_reg, ip_reg_field, any_solution];
    child 2 il.p68
      exception_frame <- il.p12;
      fetch_precision <- isc_$precision_from_rlen_and_size(il.w52, il.l48);
      required_arithmetic <- rlen_arith(il.w52);
