end;
operator isc_assign_node_add_to_aop il add_to_aop children 2 image 16#0DCB40;
  child 1 il.p64
    immediate_parent_wants_lvalue <- true;
    exception_frame <- il.p12;
    fetch_precision <- isc_$precision_from_rlen_and_size(il.w52, -1);
    required_arithmetic <- rlen_arith(il.w52);
    required_precision <- isc_$precision_from_rlen_and_size(il.w52, -1);
    permissible derived;
  child 2 il.p68
    exception_frame <- il.p12;
