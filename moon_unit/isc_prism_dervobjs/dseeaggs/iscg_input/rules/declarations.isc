attribute derived_from_literal +81.2 boolean;
attribute embedded_strength_reduction_temporary +81.1 boolean;
attribute field_precision +77 byte;
attribute field_requires_sign_extend +81.0 boolean;
attribute fp_reg_max +58 integer;
attribute fp_reg_result +60 integer;
attribute fp_reg_pair_max +62 integer;
attribute fp_reg_pair_result +64 integer;
attribute fp_reg_quad_max +66 integer;
attribute fp_reg_quad_result +68 integer;
attribute has_a_symbolic_displacement +82.7 boolean;
