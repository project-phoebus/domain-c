{ The opcode maps: by il$t, the opcode of the operation (isc_tool_
  generated_readonly_tables after the result kinds, 178 words each). }
map opcode_rr_reversed
  add_to_aop -> add,
  and_to_aop -> and,
  eor_to_aop -> xor,
  or_to_aop -> or,
  sub_from_aop -> rsub,
  add_top -> add,
  and_top -> and,
  eor_top -> xor,
  or_top -> or,
  sub_top -> rsub;
map opcode_rr
  add_to_aop -> add,
  and_to_aop -> and,
  eor_to_aop -> xor,
  or_to_aop -> or,
  sub_from_aop -> sub,
  add_top -> add,
  and_top -> and,
  eor_top -> xor,
  or_top -> or,
  sub_top -> sub;
map opcode_immediate
  add_to_aop -> addi,
  and_to_aop -> andi,
  eor_to_aop -> xori,
  or_to_aop -> ori,
  sub_from_aop -> subi,
  add_top -> addi,
  and_top -> andi,
  eor_top -> xori,
  or_top -> ori,
  sub_top -> subi;
map opcode_double
  f_add_to_aop -> addd,
  f_div_by_aop -> divd,
  f_mul_to_aop -> muld,
  f_sub_from_aop -> subd,
  f_add_top -> addd,
  f_div_top -> divd,
  f_mul_top -> muld,
  f_neg_top -> negd,
  f_sub_top -> subd;
map opcode_immediate_negated
  add_to_aop -> addi,
  and_to_aop -> andi,
  eor_to_aop -> xori,
  neg_to_aop -> negi,
  or_to_aop -> ori,
  add_top -> addi,
  and_top -> andi,
  eor_top -> xori,
  neg_top -> negi,
  or_top -> ori;
map opcode_single
  f_add_to_aop -> adds,
  f_div_by_aop -> divs,
  f_mul_to_aop -> muls,
  f_sub_from_aop -> subs,
  f_add_top -> adds,
  f_div_top -> divs,
  f_mul_top -> muls,
  f_neg_top -> negs,
  f_sub_top -> subs;
