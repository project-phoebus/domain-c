transform 333  ip_reg <- and_top ($1: ip_reg, $2: literal_32_bits)
  no_could_deadlock_child;
  pass_1 image 16#1411A4;
  pass_2 image 16#1BC6AA begin
    temp t1: solution;
    temp t2: solution;
    temp t3: solution;
    if result.c136 = 1 then
      t1 <- find_well_known_literal_solution(0);
    else
      t2 <- create_solution_for_ip_reg();
      if result.c137 = 1 then
        emit simple(opc$move, 0, find_well_known_literal_solution(0), t2, nil);
      else
        t3 <- address_mode_for_integer32_value(0);
        emit load(opc$loadl, 0, t3, t3.base_register, t2, t3.il, 0, t3.bits_known, t3.bits_trusted);
      end;
    end;
    emit field(opc$insert, 0, result.l356, t1, find_well_known_literal_solution(result.l352), $1);
    result.base_register <- $1.base_register;
    result.index_register <- $1.index_register;
    result.false_label <- $1.false_label;
    result.object_with_name <- $1.object_with_name;
    result.live_range <- $1.live_range;
    result.live_range_of_imaginary_part <- $1.live_range_of_imaginary_part;
    result.already_through_pass_2 <- $1.already_through_pass_2;
  end;
end;

